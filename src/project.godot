; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="FATEC DO CAOS"
config/description="Modern remake and expansion of Zombie Kill of the Week: Reborn in Godot 4"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

SoundManager="*res://scripts/core/SoundManager.gd"
WeaponDatabase="*res://scripts/weapons/WeaponDatabase.gd"
GameManager="*res://scripts/core/GameManager.gd"
NetworkManager="*res://scripts/core/NetworkManager.gd"
AchievementsManager="*res://scripts/core/AchievementsManager.gd"
PlayerStatsManager="*res://scripts/core/PlayerStatsManager.gd"
ObjectivesManager="*res://scripts/core/ObjectivesManager.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

