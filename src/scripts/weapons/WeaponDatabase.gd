func get_weapon(weapon_id: String) -> Dictionary:
	var w_data = weapons.get(weapon_id, weapons["handgun"]).duplicate(true)
	var psm = get_node_or_null("/root/PlayerStatsManager")
	if psm:
		var dmg_lvl = psm.get_weapon_upgrade_level(weapon_id, "damage")
		var fire_lvl = psm.get_weapon_upgrade_level(weapon_id, "fire_rate")
		var mag_lvl = psm.get_weapon_upgrade_level(weapon_id, "mag")
		var acc_lvl = psm.get_weapon_upgrade_level(weapon_id, "accuracy")
		
		w_data["damage"] = w_data["damage"] * (1.0 + dmg_lvl * 0.08)
		w_data["fire_rate"] = w_data["fire_rate"] * max(0.4, 1.0 - fire_lvl * 0.06)
		w_data["mag_size"] = int(w_data["mag_size"] * (1.0 + mag_lvl * 0.15))
		w_data["reserve_max"] = int(w_data["reserve_max"] * (1.0 + psm.get_ammo_bonus() + mag_lvl * 0.15))
		w_data["spread_deg"] = max(0.0, w_data.get("spread_deg", 0.0) * (1.0 - acc_lvl * 0.15))
	return w_data
